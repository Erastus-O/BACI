# Copy to .env (never commit it). Every value here is read by src/config.ts.

# Postgres. Hosted (Neon, Render, Supabase) or local: postgres://postgres@localhost:5432/baci
DATABASE_URL=

# 32 random bytes, base64: openssl rand -base64 32 — encrypts bank access tokens at rest. Keep it forever:
# losing it means every bank connection must be made again.
ENCRYPTION_KEY=

# Web app origins allowed to call the API, comma-separated.
CORS_ORIGINS=https://erastus-o.github.io,http://localhost:8081

# Plaid (https://dashboard.plaid.com → Developers → Keys). Use the secret that matches PLAID_ENV.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=GB
# OAuth returns (register each in Plaid dashboard → Developers → API → Allowed redirect URIs).
PLAID_REDIRECT_URI_WEB=https://erastus-o.github.io/BACI/oauth
PLAID_REDIRECT_URI_IOS=
PLAID_ANDROID_PACKAGE=com.baci.app
# Public URL of this server's webhook endpoint.
PLAID_WEBHOOK_URL=https://YOUR-API-HOST/v1/plaid/webhook
# Sandbox only: lets the app connect Plaid's test bank without the Link UI.
ALLOW_SANDBOX_SHORTCUT=false

# Optional: only for a private ElevenLabs agent (authentication on).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
