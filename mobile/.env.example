# Copy to .env and fill in. Restart `npx expo start` after changing.

# Public agent: the agent ID from the ElevenLabs dashboard (Agents › your agent › ID).
EXPO_PUBLIC_ELEVENLABS_AGENT_ID=

# Private agent (authentication enabled): leave the ID above empty in the app and
# run `npm run token-server` with ELEVENLABS_API_KEY + ELEVENLABS_AGENT_ID, then point this at it.
# Use your computer's LAN IP (not localhost) when testing on a phone.
EXPO_PUBLIC_BACI_TOKEN_URL=
